# Copy to .env. Defaults match docker-compose.yml; nothing here is a secret except the ones you generate.

# Postgres and Redis from docker compose
DATABASE_URL=postgres://coursemates:coursemates@localhost:5436/coursemates
REDIS_URL=redis://localhost:6380
POSTGRES_PASSWORD=coursemates

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3100
# Google OAuth client (Google Cloud console, OAuth 2.0 Client ID, Web application,
# redirect URI <APP_URL>/api/auth/callback/google). Leave empty locally and use the dev login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dev login: a Credentials provider that signs in any e-mail without a password. Refused in production
# builds whatever this says. Playwright uses it.
AUTH_DEV_LOGIN=true

# Where the app is reachable (links in e-mails, iCal export)
APP_URL=http://localhost:3100
PORT=3100

# Outbound mail: Mailpit locally (UI at http://localhost:8026). In production an SMTP URL with credentials,
# e.g. smtp://resend:API_KEY@smtp.resend.com:587
SMTP_URL=smtp://localhost:1026
EMAIL_FROM="Coursemates <no-reply@coursemates.local>"

# Rate limits (per minute)
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_MUTATIONS_PER_MINUTE=30

# Observability. Empty = off.
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Traces are opt-in: set to Tempo's OTLP/HTTP receiver from docker compose (http://localhost:4319) to export them.
# With a tracer registered, Next.js renders the page shells dynamically instead of prerendering them (see ADR 0005).
OTEL_EXPORTER_OTLP_ENDPOINT=
WORKER_METRICS_PORT=9465

# Host ports used by docker compose
WEB_PORT=3100
POSTGRES_PORT=5436
REDIS_PORT=6380
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
PROMETHEUS_PORT=9099
ALERTMANAGER_PORT=9101
GRAFANA_PORT=3005
GRAFANA_ADMIN_PASSWORD=change-me
TEMPO_PORT=3203
OTLP_HTTP_PORT=4319

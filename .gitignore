# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project
.env
.env.*
!.env.example
coverage/
playwright-report/
test-results/
.lighthouseci/
load/results/*
!load/results/latest*.json
*.tsbuildinfo
next.config.compiled.js

# terraform provider cache (keep .terraform.lock.hcl)
infra/terraform/.terraform/

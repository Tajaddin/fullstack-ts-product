{
  "name": "fullstack-ts-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "wau": "tsx --env-file-if-exists=.env scripts/wau.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/nextjs": "11.8.0",
    "@vercel/otel": "2.1.3",
    "bullmq": "6.3.16",
    "drizzle-orm": "0.45.4",
    "ics": "3.12.1",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "posthog-js": "1.438.12",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
